{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/qc",
      "destination": "/qc/index.html"
    },
    {
      "source": "/design",
      "destination": "/design/index.html"
    }
  ]
}
