{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/qc",
      "destination": "/qc/",
      "permanent": true
    },
    {
      "source": "/design",
      "destination": "/design/",
      "permanent": true
    }
  ]
}
