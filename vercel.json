{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/qc",
      "destination": "/qc/",
      "permanent": true
    },
    {
      "source": "/design",
      "destination": "/design/",
      "permanent": true
    },
    {
      "source": "/studio",
      "destination": "/studio/",
      "permanent": true
    },
    {
      "source": "/academy",
      "destination": "/academy/",
      "permanent": true
    },
    {
      "source": "/academy/studio/:path*",
      "destination": "/studio/:path*",
      "permanent": false
    },
    {
      "source": "/academy/design/:path*",
      "destination": "/design/:path*",
      "permanent": false
    },
    {
      "source": "/academy/qc/:path*",
      "destination": "/qc/:path*",
      "permanent": false
    },
    {
      "source": "/studio/academy/:path*",
      "destination": "/academy/:path*",
      "permanent": false
    },
    {
      "source": "/studio/design/:path*",
      "destination": "/design/:path*",
      "permanent": false
    },
    {
      "source": "/studio/qc/:path*",
      "destination": "/qc/:path*",
      "permanent": false
    }
  ]
}
